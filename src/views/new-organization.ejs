<%- include('partials/header') %>

    <div class="container">
        <div class="auth-card" style="max-width:600px">
            <h1>
                <%= title %>
            </h1>

            <form action="/new-organization" method="POST">
                <div class="form-group">
                    <label for="name">Organization Name</label>
                    <input type="text" id="name" name="name" required />
                </div>
                <div class="form-group">
                    <label for="description">Description</label>
                    <textarea id="description" name="description" rows="4"
                        style="width:100%;padding:0.6rem 0.85rem;border:1px solid var(--color-border);border-radius:var(--radius);font-size:1rem;"
                        required></textarea>
                </div>
                <div class="form-group">
                    <label for="contactEmail">Contact Email</label>
                    <input type="email" id="contactEmail" name="contactEmail" required />
                </div>
                <button type="submit" class="btn btn-primary btn-full">Create Organization</button>
            </form>
        </div>
    </div>

    <%- include('partials/footer') %>