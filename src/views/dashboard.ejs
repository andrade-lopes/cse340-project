<%- include('partials/header') %>

    <div class="container">
        <h1>Welcome, <%= user.name %>!</h1>
        <p class="dashboard-subtitle">Manage your volunteer commitments below.</p>

        <section class="dashboard-section">
            <h2>My Volunteer Projects</h2>

            <% if (volunteeredProjects && volunteeredProjects.length> 0) { %>
                <table class="volunteer-table">
                    <thead>
                        <tr>
                            <th>Project</th>
                            <th>Date</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% volunteeredProjects.forEach(function(project) { %>
                            <tr>
                                <td>
                                    <a href="/projects/<%= project.project_id %>">
                                        <%= project.project_name %>
                                    </a>
                                </td>
                                <td>
                                    <% if (project.project_date) { %>
                                        <%= new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric'
                                            , month: 'long' , day: 'numeric' }) %>
                                            <% } else { %>
                                                TBD
                                                <% } %>
                                </td>
                                <td>
                                    <a href="/volunteer/remove/<%= project.project_id %>?from=dashboard"
                                        class="btn btn-secondary btn-small"
                                        onclick="return confirm('Remove yourself as a volunteer from this project?')">
                                        Remove
                                    </a>
                                </td>
                            </tr>
                            <% }); %>
                    </tbody>
                </table>
                <% } else { %>
                    <div class="empty-state">
                        <p>You haven't signed up to volunteer for any projects yet.</p>
                        <a href="/projects" class="btn btn-primary">Browse Projects</a>
                    </div>
                    <% } %>
        </section>
    </div>

    <%- include('partials/footer') %>