<%- include('partials/header') %>

    <div class="container">
        <div class="page-header">
            <h1>
                <%= title %>
            </h1>
            <a href="/new-organization" class="btn btn-primary">Add Organization</a>
        </div>

        <% if (organizations && organizations.length> 0) { %>
            <div class="card-grid">
                <% organizations.forEach(function(org) { %>
                    <div class="card">
                        <h2><a href="/organization/<%= org.organization_id %>">
                                <%= org.name %>
                            </a></h2>
                        <p>
                            <%= org.description.length> 120 ? org.description.substring(0, 120) + '...' :
                                org.description %>
                        </p>
                        <a href="/organization/<%= org.organization_id %>" class="btn btn-outline">View Details</a>
                    </div>
                    <% }); %>
            </div>
            <% } else { %>
                <p>No organizations yet. <a href="/new-organization">Add the first one!</a></p>
                <% } %>
    </div>

    <%- include('partials/footer') %>