<%- include('partials/header') %>

    <div class="container">
        <h1>
            <%= title %>
        </h1>

        <% if (projects && projects.length> 0) { %>
            <div class="projects-grid">
                <% projects.forEach(function(project) { %>
                    <div class="project-card">
                        <h2><a href="/projects/<%= project.project_id %>">
                                <%= project.project_name %>
                            </a></h2>
                        <% if (project.project_date) { %>
                            <p class="project-date">
                                <%= new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric' ,
                                    month: 'long' , day: 'numeric' }) %>
                            </p>
                            <% } %>
                                <p class="project-excerpt">
                                    <%= project.description.length> 120 ? project.description.substring(0, 120) + '...'
                                        : project.description %>
                                </p>
                                <% if (project.organization_name) { %>
                                    <p class="project-org">
                                        <%= project.organization_name %>
                                    </p>
                                    <% } %>
                                        <a href="/projects/<%= project.project_id %>" class="btn btn-outline">Learn
                                            More</a>
                    </div>
                    <% }); %>
            </div>
            <% } else { %>
                <p>No projects available at this time. Please check back soon!</p>
                <% } %>
    </div>

    <%- include('partials/footer') %>