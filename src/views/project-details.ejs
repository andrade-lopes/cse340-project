<%- include('partials/header') %>

    <div class="container">
        <a href="/projects" class="back-link">&larr; Back to Projects</a>

        <article class="project-detail">
            <h1>
                <%= project.project_name %>
            </h1>

            <% if (project.project_date) { %>
                <p class="project-meta">
                    <strong>Date:</strong>
                    <%= new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric' , month: 'long' ,
                        day: 'numeric' }) %>
                </p>
                <% } %>
                    <% if (project.organization_name) { %>
                        <p class="project-meta"><strong>Organization:</strong>
                            <%= project.organization_name %>
                        </p>
                        <% } %>

                            <div class="project-description">
                                <h2>About This Project</h2>
                                <p>
                                    <%= project.description %>
                                </p>
                            </div>

                            <% if (isLoggedIn) { %>
                                <div class="volunteer-section">
                                    <% if (isVolunteer) { %>
                                        <p class="volunteer-status volunteer-active">✓ You are volunteering for this
                                            project.</p>
                                        <a href="/volunteer/remove/<%= project.project_id %>" class="btn btn-secondary">
                                            Remove me as a volunteer
                                        </a>
                                        <% } else { %>
                                            <p class="volunteer-status">Interested in helping out?</p>
                                            <a href="/volunteer/add/<%= project.project_id %>" class="btn btn-primary">
                                                Volunteer for this project
                                            </a>
                                            <% } %>
                                </div>
                                <% } %>
        </article>
    </div>

    <%- include('partials/footer') %>