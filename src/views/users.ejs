<%- include('partials/header') %>

    <div class="container">
        <h1>
            <%= title %>
        </h1>

        <% if (users && users.length> 0) { %>
            <table class="volunteer-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                    </tr>
                </thead>
                <tbody>
                    <% users.forEach(function(user) { %>
                        <tr>
                            <td>
                                <%= user.name %>
                            </td>
                            <td>
                                <%= user.email %>
                            </td>
                            <td>
                                <span class="role-badge role-<%= user.role_name %>">
                                    <%= user.role_name %>
                                </span>
                            </td>
                        </tr>
                        <% }); %>
                </tbody>
            </table>
            <% } else { %>
                <p>No users found.</p>
                <% } %>
    </div>

    <%- include('partials/footer') %>