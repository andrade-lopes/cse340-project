<%- include('partials/header') %>

    <div class="container">
        <div class="hero">
            <h1>Welcome to ServeConnect</h1>

            <p class="hero-subtitle">
                Connect with meaningful service projects in your community.
                Browse opportunities, volunteer your time, and make a difference.
            </p>
            <div class="hero-actions">
                <a href="/projects" class="btn btn-primary">Browse Projects</a>
                <% if (isLoggedIn) { %>
                    <a href="/dashboard" class="btn btn-outline">My Dashboard</a>
                    <% } else { %>
                        <a href="/register" class="btn btn-outline">Get Started</a>
                        <% } %>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>