<%- include('partials/header') %>

    <div class="container">
        <div class="page-header">
            <h1>
                <%= title %>
            </h1>
            <a href="/new-category" class="btn btn-primary">Add Category</a>
        </div>

        <% if (categories && categories.length> 0) { %>
            <ul class="simple-list">
                <% categories.forEach(function(category) { %>
                    <li>
                        <a href="/category/<%= category.category_id %>">
                            <%= category.category_name %>
                        </a>
                        <a href="/edit-category/<%= category.category_id %>" class="btn btn-outline btn-small">Edit</a>
                    </li>
                    <% }); %>
            </ul>
            <% } else { %>
                <p>No categories yet. <a href="/new-category">Add the first one!</a></p>
                <% } %>
    </div>

    <%- include('partials/footer') %>